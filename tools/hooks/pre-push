#!/bin/sh
# Portable bootstrap; tools/harness/PrePushCheck.java owns all push policy.
set -e

root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"

if command -v java >/dev/null 2>&1; then
    JAVA=java
elif command -v java.exe >/dev/null 2>&1; then
    JAVA=java.exe
else
    echo "pre-push: java was not found on PATH" >&2
    exit 1
fi

classes=".worldline/gate/classes"
if [ ! -f "$classes/PrePushCheck.class" ]; then
    "$JAVA" tools/harness/Gate.java
    WORLDLINE_PREPUSH_BOOTSTRAPPED=1
    export WORLDLINE_PREPUSH_BOOTSTRAPPED
fi

exec "$JAVA" -cp "$classes" PrePushCheck
